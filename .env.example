# Copy this file to `.env` and edit it. Compose reads `.env` automatically
# and interpolates the values into compose.yml — this file is the single
# place where routine settings live.
#
# Two things to know:
#   - Variables already exported in your shell silently override values here.
#   - Don't use inline comments ("KEY=value # comment") — the comment becomes
#     part of the value.

##
# Public URL: how browsers reach the site. This is the *public* address, not
# any internal container address. Every setting that must agree on it (the
# UI's REST location, REST's self-reported URLs) is derived from these.
##

# Scheme and SSL flag must agree: https <-> true
PUBLIC_SCHEME=http
PUBLIC_SSL=false

PUBLIC_HOST=localhost
PUBLIC_PORT=8080

# The port portion of the public URL, *including* the colon. Set it to blank
# when the site runs on the scheme's default port (80/443) so generated links
# don't contain ":443".
PUBLIC_PORT_SUFFIX=:8080

# Derived from the above; you shouldn't need to edit this
PUBLIC_URL=${PUBLIC_SCHEME}://${PUBLIC_HOST}${PUBLIC_PORT_SUFFIX}

##
# DSpace
##

# Give your site a fancy name!
DSPACE_NAME=DSpace Started with Docker Compose

# The internal bridge network's subnet. DSpace trusts this range as a proxy
# (proxies.trusted.ipranges is derived from it, so the two can't drift).
# Change it if it collides with another compose stack or your LAN.
DSPACE_SUBNET=172.23.78.0/24

# Example maven flags from the original DSpace docker setup for a faster REST
# image build (but probably harder to debug? Comments didn't make it clear
# what the downside is)
#MAVEN_FLAGS=-P-test-environment -Denforcer.skip=true -Dcheckstyle.skip=true -Dlicense.skip=true -Dxml.skip=true

# JVM options for the REST (Tomcat) container
#REST_JAVA_OPTS=-Xmx2000m

# Production: how many SSR worker processes pm2 runs in the angular
# container. Defaults to "max", one per CPU core — cap it on shared hosts.
#PM2_INSTANCES=4

##
# Caddy (the "web" service)
##

# The host port for Caddy's public listener — Caddy is host-networked, so
# this *is* the public port (unless another proxy sits in front). Rootless
# podman can't bind ports below 1024 unless you lower
# net.ipv4.ip_unprivileged_port_start.
CADDY_HTTP_PORT=8080

# If running behind another proxy, add it here. The default is to trust
# private network ranges.
#CADDY_TRUSTED_PROXIES=static private_ranges <external proxies here>

# This must be blank or the word "debug" - affects logging verbosity
#CADDY_DEBUG=debug

# Admin range(s) for users who are allowed to access the TPS admin section
CADDY_ADMIN_CIDR=127.0.0.1

# Internal monitor range(s) who can bypass TPS. Use *very* carefully!
CADDY_INTERNAL_MONITOR_CIDR=127.0.0.1

##
# Loopback ports on the host. Caddy and TPS run with host networking, so
# these are real (loopback-only) host ports: Caddy reaches angular and REST
# through the first two, TPS binds the third, and Caddy's challenge-free
# internal listener binds the fourth. Everything that must agree on these is
# derived from them, so you only need to change them on port collisions.
##

ANGULAR_HOST_PORT=4000
REST_HOST_PORT=8081
TPS_HOST_PORT=18888
CADDY_INTERNAL_PORT=18081

##
# TPS secrets. No defaults on purpose: the stack refuses to start until all
# four are set.
##

# Cloudflare Turnstile keys. The values below are Cloudflare's *test* keys —
# every challenge auto-passes. Fine for development; real deployments MUST
# replace them with their own widget's keys.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Choose long random values for both of these! JWT_SIGNING_KEY signs the
# tokens TPS hands out after a passed challenge; ADMIN_SECRET gates the TPS
# admin API.
JWT_SIGNING_KEY=
ADMIN_SECRET=
