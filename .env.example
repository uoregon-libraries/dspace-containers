# Copy this file to `.env` and edit. Shell vars take priority, so generally
# just don't set them!

##
# Public URL vars: these make up the URL you'll use to request SB, not the internal URLs
##

# Sadly we can't derive the SSL flag from scheme, so make sure these agree
PUBLIC_SCHEME=http
PUBLIC_SSL=false

PUBLIC_HOST=localhost
PUBLIC_PORT=8080

# The port portion of the public URL, *including* the colon. This can usually
# be blank as the public URL won't have a port (443 is implicit).
PUBLIC_PORT_SUFFIX=:8080

# Derived from the above; you shouldn't need to edit this
PUBLIC_URL=${PUBLIC_SCHEME}://${PUBLIC_HOST}${PUBLIC_PORT_SUFFIX}

##
# DSpace
##

# Give your site a fancy name!
DSPACE_NAME=My First DSpace

# The internal bridge network's subnet. DSpace trusts this range as a proxy,
# and DSpace *requires* a trusted CIDR, so we have to pick *something*.
DSPACE_SUBNET=172.23.78.0/24

# Example maven flags from the original DSpace docker setup for a faster REST
# image build (but probably harder to debug? Comments didn't make it clear
# what the downside is)
#MAVEN_FLAGS=-P-test-environment -Denforcer.skip=true -Dcheckstyle.skip=true -Dlicense.skip=true -Dxml.skip=true

# JVM options for the REST (Tomcat) container
#REST_JAVA_OPTS=-Xmx2000m

# Production: how many SSR worker processes pm2 runs in the angular
# container. Defaults to "max", one per CPU core.
#PM2_INSTANCES=4

##
# Caddy (the "web" service)
##

# The host port for Caddy's public listener. Caddy is *host-networked*, so this
# needs to be an available port on the host. With no proxy (e.g., local dev),
# this has to match the public port. In prod setups with a real proxy (e.g.,
# HAProxy), said proxy needs to point here.
CADDY_HTTP_PORT=8080

# If running behind another proxy, add it here. The default is to trust
# private network ranges.
#CADDY_TRUSTED_PROXIES=static private_ranges <external proxies here>

# This must be blank or the word "debug" - affects logging verbosity
#CADDY_DEBUG=debug

# Admin range(s) for users who are allowed to access the TPS admin section
CADDY_ADMIN_CIDR=127.0.0.1

# Internal monitor range(s) who can bypass TPS (e.g., Zabbix, security
# scanners, etc.). Use *very* carefully!
CADDY_INTERNAL_MONITOR_CIDR=127.0.0.1

# How long Caddy keeps rotated request logs (a Go duration). 720h = 30 days;
# production should use 2160h (90 days).
#CADDY_LOG_RETENTION=720h

##
# More ports exposed to the host, yay! These must be exposed, but they only
# bind to the loopback (127.0.0.1) network. Because Caddy has to be
# host-networked, TPS also much be (it proxies to Caddy's internal listener),
# and for them to proxy to anything else, those other services have to be bound
# to the host instead of purely internal. Binding to loopback at least makes
# them safe, but you still might have collisions on a shared server (e.g. local
# dev).
##

ANGULAR_HOST_PORT=4000
REST_HOST_PORT=8081
TPS_HOST_PORT=18888
CADDY_INTERNAL_PORT=18081

##
# Caddy upstream Host headers. X-Forwarded-Proto is derived from PUBLIC_SCHEME
# automatically. These live *after* the port vars above because .env
# interpolation is top-down.
##

# Host header for the REST upstream. The default is a Caddy runtime
# placeholder meaning "pass the client's own Host through unchanged".
# Production should pin the public hostname instead, e.g.:
#CADDY_REST_HOST_HEADER=scholarsbank.uoregon.edu
CADDY_REST_HOST_HEADER={http.request.hostport}

# Host header for the Angular upstream. Dev points at the SSR server itself;
# production should pin the public hostname, same as above.
CADDY_ANGULAR_HOST_HEADER=localhost:${ANGULAR_HOST_PORT}

##
# TPS secrets. You have to manually set this stuff or the stack refuses to start.
##

# Cloudflare keys come from your cloudflare account, or test keys (see below)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Choose random, long values for these
JWT_SIGNING_KEY=
ADMIN_SECRET=

###
# Cloudflare: test site keys adjust the behavior of the challenge. Remove the
# comment at the end if you copy and paste, otherwise that becomes part of the
# value.
###
#TURNSTILE_SITE_KEY=1x00000000000000000000AA # Always passes, visible
#TURNSTILE_SITE_KEY=2x00000000000000000000AB # Always fails, visible
#TURNSTILE_SITE_KEY=1x00000000000000000000BB # Always passes, invisible
#TURNSTILE_SITE_KEY=2x00000000000000000000BB # Always fails, invisible
#TURNSTILE_SITE_KEY=3x00000000000000000000FF # Force interactive challenge, visible

###
# Cloudflare: test secret keys adjust the behavior of the validation (after the
# challenge has finished). Remove the comment at the end if you copy and paste,
# otherwise that becomes part of the value.
###
#TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA # Always passes validation
#TURNSTILE_SECRET_KEY=2x0000000000000000000000000000000AA # Always fails validation
