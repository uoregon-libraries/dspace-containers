# This snippet enables the post-challenge listener for TPS or Anubis to use.
#
# See docs/install/bot-protection.md for usage and bot protection details.

# This port should never be published to the host unless you're testing
# something, otherwise bots could potentially bypass your protections.
:18081 {
	import /etc/caddy/sb-routing.caddyfile

	log http-internal-access {
		level INFO
	}
}

