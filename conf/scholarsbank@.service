# Rootless podman user unit for the stack. It's a template so no host paths
# live in the repo: the instance name is the escaped path of the checkout,
# which %f turns back into the working directory. See "Running under systemd"
# in README.md.
#
#   systemctl --user enable --now "scholarsbank@$(systemd-escape --path /path/to/scholarsbank/app).service"

[Unit]
Description=Scholars' Bank (%f)
# Give up if it fails 3 times within a minute rather than thrashing forever
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
WorkingDirectory=%f
# podman compose hands off to podman-compose, which is often a pip/pipx
# install in ~/.local/bin, not on a user manager's default PATH
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/podman compose up web
ExecStop=/usr/bin/podman compose down
TimeoutStartSec=0
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
